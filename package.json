    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-router": "^7.17.0",
    "react-toastify": "^11.1.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
